{
  "schema": 1,
  "dataset": "target-contract-representative-v1",
  "ranges": [
    {"source": "Security.jsonl", "select": {"count": 3, "required_event_data_fields": ["IpAddress", "TargetUserName"]}, "destination": "Security.jsonl"},
    {"source": "System.jsonl", "select": {"count": 2, "required_event_data_fields": ["ServiceName", "ImagePath"]}, "destination": "System.jsonl"}
  ],
  "required_shapes": {
    "authentication": {"file": "Security.jsonl", "ip_field": "IpAddress", "message_field": "TargetUserName"},
    "inventory": {"file": "System.jsonl", "service_field": "ServiceName", "process_field": "ImagePath"},
    "reported_context": {"file": "Security.jsonl", "line": 2, "message_field": "TargetUserName"},
    "timeline": {"left_file": "Security.jsonl", "right_file": "System.jsonl", "time_field": "System.TimeCreated"}
  }
}
