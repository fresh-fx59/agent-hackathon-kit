diff --git a/app/checkout.py b/app/checkout.py
--- a/app/checkout.py
+++ b/app/checkout.py
@@ -1,7 +1,8 @@
 """Checkout: discount calculation and order creation.
 
-Discount model: the promo-code discount and the loyalty discount stack
-additively, and the sum is capped at MAX_DISCOUNT_PERCENT.
+Discount model: the customer gets the single BEST discount (promo code or
+loyalty) -- discounts no longer stack; the result is still capped at
