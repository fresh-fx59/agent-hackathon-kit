{
  "mcpServers": {
    "tracker": {
      "command": "python3",
      "args": ["/absolute/path/to/agent-hackathon-kit/mcp/tracker_mcp.py"],
      "env": { "TRACKER_URL": "http://127.0.0.1:8801" }
    },
    "quality": {
      "command": "python3",
      "args": ["/absolute/path/to/agent-hackathon-kit/mcp/quality_mcp.py"],
      "env": { "QUALITY_URL": "http://127.0.0.1:8802" }
    },
    "forge": {
      "command": "python3",
      "args": ["/absolute/path/to/agent-hackathon-kit/mcp/forge_mcp.py"],
      "env": { "FORGE_URL": "http://127.0.0.1:8803" }
    },
    "tms": {
      "command": "python3",
      "args": ["/absolute/path/to/agent-hackathon-kit/mcp/tms_mcp.py"],
