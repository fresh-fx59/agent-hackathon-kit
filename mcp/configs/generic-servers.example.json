{
  "_comment": "Client-agnostic inventory of the four stdio MCP servers. Translate into whatever config syntax your MCP client uses. Replace relative script paths with absolute ones if your client requires them.",
  "servers": [
    {
      "name": "tracker",
      "transport": "stdio",
      "command": "python3",
      "args": ["mcp/tracker_mcp.py"],
      "env": { "TRACKER_URL": "http://127.0.0.1:8801" },
      "tools": ["create_issue", "list_issues", "get_issue", "update_issue"]
    },
    {
      "name": "quality",
      "transport": "stdio",
      "command": "python3",
      "args": ["mcp/quality_mcp.py"],
      "env": { "QUALITY_URL": "http://127.0.0.1:8802" },
      "tools": ["list_issues", "get_measures"]
    },
    {
      "name": "forge",
      "transport": "stdio",
      "command": "python3",
      "args": ["mcp/forge_mcp.py"],
      "env": { "FORGE_URL": "http://127.0.0.1:8803" },
      "tools": ["get_mr", "get_mr_diff", "create_mr", "get_file"]
    },
    {
      "name": "tms",
      "transport": "stdio",
      "command": "python3",
      "args": ["mcp/tms_mcp.py"],
      "env": { "TMS_URL": "http://127.0.0.1:8804" },
      "tools": ["list_testcases", "create_run"]
    }
  ]
}
